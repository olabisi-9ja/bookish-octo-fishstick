{
  "name": "comuta",
  "version": "0.1.0",
  "private": true,
  "description": "COMUTA - Lagos pre-booked shared commuting. Mobile app, PWA and marketing site.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @comuta/mobile",
    "pwa": "npm run dev --workspace @comuta/pwa",
    "build:pwa": "npm run build --workspace @comuta/pwa",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke --workspace @comuta/pwa"
  }
}
